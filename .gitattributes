# Normalize line endings: LF in the repository and in the working tree.
* text=auto eol=lf

# Windows batch files must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never normalize or diff as text.
*.ico binary
*.icns binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.wasm binary
*.exe binary
*.dll binary
*.zip binary
*.7z binary
*.mp4 binary
*.webm binary
*.mp3 binary
*.m4a binary
